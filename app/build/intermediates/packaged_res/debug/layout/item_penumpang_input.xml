<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_card" android:padding="14dp"
    android:orientation="vertical" android:layout_marginBottom="10dp">

    <TextView android:id="@+id/tvLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/blue" android:textStyle="bold"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nama Lengkap" android:textColor="@color/muted" android:textSize="12sp"
        android:layout_marginTop="10dp"/>
    <EditText android:id="@+id/etNama" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:padding="10dp" android:inputType="textPersonName"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Umur" android:textColor="@color/muted" android:textSize="12sp"
        android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etUmur" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:padding="10dp" android:inputType="number"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nomor HP" android:textColor="@color/muted" android:textSize="12sp"
        android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etHp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:padding="10dp" android:inputType="phone"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Email" android:textColor="@color/muted" android:textSize="12sp"
        android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:padding="10dp" android:inputType="textEmailAddress"/>
</LinearLayout>
