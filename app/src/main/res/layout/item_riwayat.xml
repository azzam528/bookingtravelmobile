<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_card" android:padding="14dp"
    android:orientation="vertical" android:layout_marginBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvTravel" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/text"
            android:textStyle="bold" android:textSize="15sp"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textStyle="bold" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvRute" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text"/>
    <TextView android:id="@+id/tvInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="12sp"/>
    <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/orange" android:textStyle="bold" android:layout_marginTop="4dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBatal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"

        android:background="@drawable/bg_btn_red"
        android:backgroundTint="@null"

        android:text="Batalkan Pesanan"
        android:textColor="@android:color/white"
        android:textStyle="bold"

        android:padding="10dp"/>
</LinearLayout>
